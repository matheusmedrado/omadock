#!/usr/bin/env bash

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
cd "$repo_root"

if ! command -v omarchy >/dev/null 2>&1; then
    printf 'OmaDock smoke test: omarchy not found; skipped\n'
    exit 0
fi

omarchy plugin validate .

qmllint_bin=$(command -v qmllint || true)
if [ -z "$qmllint_bin" ] && [ -x /usr/lib/qt6/bin/qmllint ]; then
    qmllint_bin=/usr/lib/qt6/bin/qmllint
fi

if [ -n "$qmllint_bin" ] && [ -n "${OMARCHY_PATH:-}" ]; then
    "$qmllint_bin" -I "$OMARCHY_PATH/shell" \
        Overlay.qml components/*.qml services/*.qml tests/*.qml
else
    printf 'OmaDock smoke test: qmllint or OMARCHY_PATH not found; skipped QML lint\n'
fi

printf 'OmaDock smoke test: passed\n'
