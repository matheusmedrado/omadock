#!/usr/bin/env bash

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
cd "$repo_root"

fail() {
    printf 'OmaDock check: %s\n' "$1" >&2
    exit 1
}

command -v jq >/dev/null 2>&1 || fail "jq is required"

jq -e . manifest.json >/dev/null || fail "manifest.json is not valid JSON"
jq -e . config/defaults.json >/dev/null || fail "config/defaults.json is not valid JSON"

manifest_version=$(jq -er '.version' manifest.json) || fail "manifest version is missing"
changelog_version=$(sed -n 's/^## \[\([^]]*\)\].*/\1/p' CHANGELOG.md \
    | grep -v '^Unreleased$' | head -n 1 || true)
[ -n "$changelog_version" ] || fail "changelog version is missing"
[ "$manifest_version" = "$changelog_version" ] \
    || fail "manifest version does not match the latest changelog version"

plugin_id=$(jq -er '.id' manifest.json) || fail "manifest ID is missing"
grep -qF "$plugin_id" README.md \
    || fail "README does not use the permanent plugin ID"
grep -qF "https://github.com/matheusmedrado/omadock.git" README.md \
    || fail "README does not use the repository URL"
[ -f LICENSE ] || fail "LICENSE file is missing"
[ "$(jq -er '.license' manifest.json)" = "MIT" ] \
    || fail "manifest license must be MIT"
[ -s preview.png ] || fail "preview.png is missing or empty"
grep -qF "![OmaDock preview](preview.png)" README.md \
    || fail "README does not reference preview.png"

jq -e '
    .schemaVersion == 1
    and (.id | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
    and (.id | contains("/") | not)
    and (.id | contains("..") | not)
    and (.id | startswith("omarchy.") | not)
    and (.name | type == "string" and length > 0)
    and (.version | type == "string" and length > 0)
    and (.kinds | type == "array" and length > 0)
    and (.entryPoints | type == "object")
    and ((.kinds | index("overlay")) == null or
         (.entryPoints.overlay | type == "string" and length > 0))
    and ((.kinds | index("bar-widget")) == null or
         (.entryPoints.barWidget | type == "string" and length > 0))
' manifest.json >/dev/null || fail "manifest contract is invalid"

# Every declared entry point must be a safe relative path that actually exists.
while IFS= read -r entry_point; do
    case "$entry_point" in
        /*|../*|*/../*|..)
            fail "entry point must be a safe relative path: $entry_point"
            ;;
    esac
    [ -f "$entry_point" ] || fail "entry point does not exist: $entry_point"
done < <(jq -er '.entryPoints | to_entries[] | .value' manifest.json)

find . -path './.git' -prune -o -type l -print -quit | grep -q . \
    && fail "symlinks are not allowed in the plugin tree"

while IFS= read -r executable; do
    case "$executable" in
        ./scripts/check|./scripts/smoke-test) ;;
        *) fail "unexpected executable file: $executable" ;;
    esac
done < <(find . -path './.git' -prune -o -type f -perm /111 -print)

jq -e '
    .version == 1
    and .position == "bottom"
    and (.monitorMode as $mode |
         (["all", "focused", "named"] | index($mode)) != null)
    and (.monitors | type == "array")
    and (.appearance | type == "object")
    and (.behavior | type == "object")
    and (.pinned | type == "array")
    and (.aliases | type == "object")
' config/defaults.json >/dev/null || fail "default configuration is invalid"

# Capture rather than branching on the exit status directly: a scanner that
# fails to run exits non-zero too, which an `if scanner; then fail; fi` reads as
# "nothing found". This check silently passed for exactly that reason while the
# script still called ripgrep, which CI does not install.
forbidden=$(grep -rnE --include='*.qml' --include='*.js' --include='*.json' \
    --exclude-dir=.git \
    '(sudo|pkexec|bash[[:space:]]+-c|curl|wget|https?://)' . || true)
if [ -n "$forbidden" ]; then
    printf '%s\n' "$forbidden" >&2
    fail "forbidden command or runtime network reference found"
fi

git diff --check || fail "whitespace errors found"

qmllint_bin=$(command -v qmllint || true)
if [ -z "$qmllint_bin" ] && [ -x /usr/lib/qt6/bin/qmllint ]; then
    qmllint_bin=/usr/lib/qt6/bin/qmllint
fi

# Almost every type this plugin uses comes from Quickshell or the Omarchy shell.
# Without OMARCHY_PATH to resolve them, qmllint reports each one as an error and
# says nothing about the code, so it is skipped rather than run blind. That is
# why CI installs Qt for the test runner but does not lint.
if [ -z "$qmllint_bin" ]; then
    printf 'OmaDock check: qmllint not found; skipping QML lint\n'
elif [ -z "${OMARCHY_PATH:-}" ]; then
    printf 'OmaDock check: OMARCHY_PATH is not set; skipping QML lint\n'
else
    qml_files=(Overlay.qml BarPanel.qml components/*.qml services/*.qml tests/*.qml)
    "$qmllint_bin" -I "$OMARCHY_PATH/shell" "${qml_files[@]}"
fi

qmltestrunner_bin=$(command -v qmltestrunner || true)
if [ -z "$qmltestrunner_bin" ] && [ -x /usr/lib/qt6/bin/qmltestrunner ]; then
    qmltestrunner_bin=/usr/lib/qt6/bin/qmltestrunner
fi

# Skipping the suite keeps the check usable on a machine without Qt, but a CI
# run that skips it is a green tick over nothing. OMADOCK_REQUIRE_TESTS turns the
# skip into a failure so a broken toolchain is visible rather than silent.
if [ -n "$qmltestrunner_bin" ]; then
    env -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen \
        QML_XHR_ALLOW_FILE_READ=1 \
        "$qmltestrunner_bin" -input tests \
        || fail "QML tests failed"
elif [ "${OMADOCK_REQUIRE_TESTS:-0}" = "1" ]; then
    fail "qmltestrunner not found and OMADOCK_REQUIRE_TESTS is set"
else
    printf 'OmaDock check: qmltestrunner not found; skipping QML tests\n'
fi

printf 'OmaDock check: passed\n'
